{
  "name": "mmd-flowchart",
  "displayName": "MMD Flowchart",
  "description": "Visuele editor voor Mermaid-flowcharts (.mmd).",
  "version": "0.1.0",
  "publisher": "dictu",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "mmdFlowchart.editor",
        "displayName": "MMD Flowchart",
        "selector": [
          {
            "filenamePattern": "*.mmd"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "mmdFlowchart.openPreview",
        "title": "Open preview naast de tekst",
        "icon": "$(open-preview)",
        "category": "MMD Flowchart"
      },
      {
        "command": "mmdFlowchart.openText",
        "title": "Open als tekst",
        "icon": "$(go-to-file)",
        "category": "MMD Flowchart"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mmdFlowchart.openPreview",
          "when": "resourceExtname == .mmd && activeCustomEditorId != mmdFlowchart.editor",
          "group": "navigation"
        },
        {
          "command": "mmdFlowchart.openText",
          "when": "activeCustomEditorId == mmdFlowchart.editor",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "mmdFlowchart.openPreview",
          "when": "resourceExtname == .mmd",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "mmdFlowchart.openPreview",
          "when": "resourceExtname == .mmd"
        },
        {
          "command": "mmdFlowchart.openText",
          "when": "activeCustomEditorId == mmdFlowchart.editor"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "package": "npm run compile && vsce package --skip-license"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.6.3"
  }
}
